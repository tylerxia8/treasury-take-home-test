# Copy this file to `.env.local` and fill in your key.
# Get a key at https://console.anthropic.com/

# Required for live verification. If unset, the app runs in MOCK mode
# (returns realistic canned results so the UI is testable without a key).
ANTHROPIC_API_KEY=

# Optional overrides (sensible defaults are used if omitted):

# Vision model used for label extraction.
# claude-opus-4-8 = best accuracy/judgment; claude-sonnet-4-6 / claude-haiku-4-5 = faster.
ANTHROPIC_MODEL=claude-opus-4-8

# Reasoning effort for extraction: low | medium | high | max.
# "low" keeps latency near the ~5s target; raise for hard/skewed images.
EXTRACTION_EFFORT=low

# Max images processed concurrently in a batch (protects against rate limits).
BATCH_CONCURRENCY=6
